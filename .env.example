# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# Server LLM selection. The provider preset chooses default deep/quick models.
# deepseek uses deepseek-v4-pro for deep research and deepseek-v4-flash for quick steps.
# Options: deepseek, openai, openrouter, qwen
ALPHAMIND_LLM_PROVIDER=deepseek

# Optional model overrides for the selected provider preset.
# ALPHAMIND_DEEP_LLM=deepseek-v4-pro
# ALPHAMIND_QUICK_LLM=deepseek-v4-flash

# Optional custom OpenAI-compatible endpoint.
# ALPHAMIND_LLM_BACKEND_URL=
